pipeline {
    agent any


    tools {
        nodejs 'Node-22'
    }

    environment {
        IMAGE_NAME = 'moudle8848/task-app'
        IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_CREDENTIALS = 'docker_credentials'
        DEPLOY_CREDENTIALS = 'deploye_server_credentials'

        DEPLOY_USER = 'ubuntu'
        DEPLOY_HOST = '10.0.1.129'
        DEPLOY_PATH = '/opt/task-app'
    }

    stages {

        stage('Build') {
            steps {
                dir('task-app') {
                    sh '''
                        set -e

                        echo "Installing dependencies..."
                        npm ci

                        echo "Building Docker image..."

                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest \
                            .
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('task-app') {
                    sh '''
                        set -e

                        echo "Running tests..."
                        npm test
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Logging in to Docker Hub..."

                            echo "$DOCKER_PASSWORD" | docker login \
                                -u "$DOCKER_USERNAME" \
                                --password-stdin

                            echo "Pushing image ${IMAGE_NAME}:${IMAGE_TAG}..."

                            docker push ${IMAGE_NAME}:${IMAGE_TAG}

                            echo "Pushing latest image..."

                            docker push ${IMAGE_NAME}:latest

                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sshagent(credentials: ["${DEPLOY_CREDENTIALS}"]) {
                            sh '''
                                set -e

                                echo "Deploying to ${DEPLOY_HOST}..."

                                echo "Creating deployment directory..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "mkdir -p ${DEPLOY_PATH}"

                                echo "Copying docker-compose.yml..."

                                scp -o StrictHostKeyChecking=no \
                                    task-app/docker-compose.yml \
                                    ${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/docker-compose.yml

                                echo "Logging into Docker Hub..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "echo '${DOCKER_PASSWORD}' | docker login \
                                    -u '${DOCKER_USERNAME}' \
                                    --password-stdin"

                                echo "Pulling image ${IMAGE_NAME}:${IMAGE_TAG}..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "cd ${DEPLOY_PATH} && \
                                    docker pull ${IMAGE_NAME}:${IMAGE_TAG}"

                                echo "Validating Docker Compose..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "cd ${DEPLOY_PATH} && \
                                    docker compose config"

                                echo "Starting application..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "cd ${DEPLOY_PATH} && \
                                    docker compose up -d"

                                echo "Checking containers..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "cd ${DEPLOY_PATH} && \
                                    docker compose ps"

                                echo "Cleaning old images..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "docker image prune -f"

                                echo "Logging out from Docker Hub..."

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                                    "docker logout"

                                echo "Deployment completed successfully."
                            '''
                        }
                    }
                }
            }
        }


    }

    post {
        success {
            echo "Pipeline completed successfully."
            echo "Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "Pipeline failed."
        }

        always {
            sh 'docker logout || true'
        }
    }

}
